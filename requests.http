{
  "username": "andreeacapitanu",
  "email": "andreeacapitanu@gmail.com",
  "password": "Andree@2003",
  "nickname": "Andreea",
  "bio": "I love cooking!",
  "age": 30,
  "authorization": false,
  "vegetarian": false,
  "role": "USER"
}

